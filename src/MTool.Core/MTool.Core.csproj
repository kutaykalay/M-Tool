<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MTool.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MTool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Devices\*.json" LogicalName="MTool.Devices.%(Filename)%(Extension)" />
    <EmbeddedResource Update="Resources\CoreStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>MTool.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreStrings</StronglyTypedClassName>
      <StronglyTypedManifestPrefix>MTool.Core.Resources</StronglyTypedManifestPrefix>
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreStrings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
