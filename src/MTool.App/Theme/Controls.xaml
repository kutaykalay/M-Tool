<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vm="clr-namespace:MTool.App.ViewModels"
                    xmlns:theme="clr-namespace:MTool.App.Theme">

    <!-- Colours come from Light.xaml / Dark.xaml through DynamicResource, so a theme swap repaints. -->

    <theme:EqualityConverter x:Key="Equal" />
    <theme:NotNullToVisibilityConverter x:Key="NotNullToVisible" />
    <theme:InverseBooleanConverter x:Key="Not" />
    <theme:AnyTrueConverter x:Key="AnyTrue" />
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,12,0,6" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- A coloured band; Tag holds the MessageKind. -->
    <Style x:Key="Band" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.BandText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Info}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static vm:MessageKind.Warning}">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static vm:MessageKind.Error}">
                <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Button that shows a selected state when Tag is true (bound through the Equal converter). -->
    <Style x:Key="Choice" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Text longer than the button (a longer translation) ends in "…"; the button's tooltip shows it whole. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small rounded button for a secondary action next to a section title. -->
    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
        A bar with four dots (0-3): click a dot or drag the knob. The dots sit half a knob in from each
        end, where the Track puts the knob's centre at the minimum and the maximum. Tag False hides the
        knob: the value is none of the steps.
    -->
    <Style x:Key="StepSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="3" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- Transparent, not null: the whole bar takes clicks. -->
                    <Grid x:Name="Root" Height="22" Background="Transparent">
                        <Rectangle Height="2" Margin="9,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border}" />
                        <Grid Margin="9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="-4,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource Brush.TextMuted}" />
                            <Ellipse Grid.Column="1" Width="8" Height="8" Margin="-4,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource Brush.TextMuted}" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="-4,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource Brush.TextMuted}" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="0,0,-4,0" HorizontalAlignment="Right" Fill="{DynamicResource Brush.TextMuted}" />
                        </Grid>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>False</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Knob" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
