<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Light.xaml; ThemeManager swaps the two. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#1C1D20" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#26282C" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#30343B" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3A3D43" />
    <SolidColorBrush x:Key="Brush.Text" Color="#ECEDEF" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A4AB" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Info" Color="#1E3A5F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#4A3B12" />
    <SolidColorBrush x:Key="Brush.Error" Color="#5A2320" />
    <SolidColorBrush x:Key="Brush.BandText" Color="#ECEDEF" />
</ResourceDictionary>
