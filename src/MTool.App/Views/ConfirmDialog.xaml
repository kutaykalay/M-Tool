<Window x:Class="MTool.App.Views.ConfirmDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MTool.App.Resources"
        Title="M-Tool" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="16,14,16,16">
        <TextBlock x:Name="QuestionText" TextWrapping="Wrap" />
        <UniformGrid Rows="1" Margin="0,16,0,0">
            <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Common_Yes}" IsDefault="True" Click="OnYesClick" />
            <Button Style="{StaticResource Choice}" Margin="0" Content="{x:Static res:Strings.Common_No}" IsCancel="True" />
        </UniformGrid>
    </StackPanel>
</Window>
