<Window x:Class="MTool.App.Views.ReportOnlyWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MTool.App.Resources"
        xmlns:vm="clr-namespace:MTool.App.ViewModels"
        Title="{x:Static res:Strings.ReportOnly_Title}" Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <!-- Scrolls only on a screen shorter than the window (MaxHeight follows the live work area). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,14,16,16">
            <TextBlock x:Name="ProblemText" TextWrapping="Wrap" />
            <StackPanel Visibility="{Binding Live, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Section}" Margin="2,12,0,6" Text="{x:Static res:Strings.Wmi2_SectionTitle}" />
                <Border Style="{StaticResource Band}" Margin="0,0,0,8" Tag="{x:Static vm:MessageKind.Warning}">
                    <!-- What control writes while it is open, what reading is otherwise. -->
                    <TextBlock Text="{Binding Controls.Band, FallbackValue={x:Static res:Strings.Wmi2_ExperimentalBand}}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource Band}" Margin="0,0,0,8" Tag="{x:Static vm:MessageKind.Info}"
                        Visibility="{Binding MsiBand.Message, Converter={StaticResource NotNullToVisible}}">
                    <TextBlock Text="{Binding MsiBand.Message}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style x:Key="LiveLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Margin" Value="0,2,12,2" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="LiveValue" TargetType="TextBlock">
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Margin" Value="0,2,0,2" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </Grid.Resources>
                        <TextBlock Grid.Row="0" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_Firmware}" />
                        <TextBlock Grid.Row="0" Style="{StaticResource LiveValue}" Text="{Binding Live.Firmware}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_ListMatch}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource LiveValue}" Text="{Binding Live.ListMatch}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_CpuTemperature}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource LiveValue}" Text="{Binding Live.CpuTemperature}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_GpuTemperature}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource LiveValue}" Text="{Binding Live.GpuTemperature}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_CpuFan}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource LiveValue}" Text="{Binding Live.CpuFan}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_GpuFan}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource LiveValue}" Text="{Binding Live.GpuFan}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_PerformanceMode}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource LiveValue}" Text="{Binding Live.PerformanceMode}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_FanMode}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource LiveValue}" Text="{Binding Live.FanMode}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_ChargeLimit}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource LiveValue}" Text="{Binding Live.ChargeLimit}" />
                        <TextBlock Grid.Row="9" Style="{StaticResource LiveLabel}" Text="{x:Static res:Strings.Wmi2_CoolerBoost}" />
                        <TextBlock Grid.Row="9" Style="{StaticResource LiveValue}" Text="{Binding Live.CoolerBoost}" />
                    </Grid>
                </Border>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="{x:Static res:Strings.Wmi2_Show}" Command="{Binding Live.ShowCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Choice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Live.IsStarted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Wmi2_Refresh}" Command="{Binding Live.RefreshCommand}"
                            Visibility="{Binding Live.IsStarted, Converter={StaticResource BoolToVisible}}" />
                    <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Wmi2_Stop}" Command="{Binding Live.StopCommand}"
                            Visibility="{Binding Live.IsStarted, Converter={StaticResource BoolToVisible}}" />
                    <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Wmi2_TryAgain}" Command="{Binding Live.TryAgainCommand}"
                            Visibility="{Binding Live.IsStopped, Converter={StaticResource BoolToVisible}}" />
                </WrapPanel>
                <Border Style="{StaticResource Band}" Tag="{Binding Live.MessageKind}" Visibility="{Binding Live.Message, Converter={StaticResource NotNullToVisible}}">
                    <TextBlock Text="{Binding Live.Message}" TextWrapping="Wrap" />
                </Border>

                <!-- Experimental control: hidden until a round has shown the firmware. -->
                <StackPanel Margin="0,4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Controls}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Controls.State}" Value="{x:Static vm:Wmi2ControlState.Hidden}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource Muted}" Margin="2,4,0,4" TextWrapping="Wrap" Text="{Binding Controls.Reason}"
                               Visibility="{Binding Controls.Reason, Converter={StaticResource NotNullToVisible}}" />
                    <WrapPanel>
                        <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Wmi2_ControlEnable}" Command="{Binding Controls.EnableCommand}"
                                Visibility="{Binding Controls.ShowEnable, Converter={StaticResource BoolToVisible}}" />
                    </WrapPanel>

                    <!-- The switches: each one is a single write the user asked for. -->
                    <StackPanel Visibility="{Binding Controls.IsOpen, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Style="{StaticResource Section}" Margin="2,8,0,6" Text="{x:Static res:Strings.Wmi2_CoolerBoost}" />
                        <Button Style="{StaticResource Choice}" Margin="0" HorizontalAlignment="Stretch" Content="Cooler Boost"
                                Tag="{Binding Controls.CoolerBoostOn}"
                                CommandParameter="{Binding Controls.CoolerBoostOn, Converter={StaticResource Not}}"
                                Command="{Binding Controls.SetCoolerBoostCommand}" />

                        <TextBlock Style="{StaticResource Section}" Margin="2,10,0,6" Text="{x:Static res:Strings.Wmi2_PerformanceMode}" />
                        <ItemsControl ItemsSource="{Binding Controls.PerformanceOptions}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Choice}" Content="{Binding Name}" ToolTip="{Binding Name}" CommandParameter="{Binding Mode}"
                                            Command="{Binding DataContext.Controls.SetPerformanceCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource Equal}">
                                                <Binding Path="Mode" />
                                                <Binding Path="DataContext.Controls.Performance" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Section}" Margin="2,10,0,6" Text="{x:Static res:Strings.Wmi2_FanMode}" />
                        <ItemsControl ItemsSource="{Binding Controls.FanModeOptions}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Choice}" Content="{Binding Name}" ToolTip="{Binding Name}" CommandParameter="{Binding Mode}"
                                            Command="{Binding DataContext.Controls.SetFanModeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource Equal}">
                                                <Binding Path="Mode" />
                                                <Binding Path="DataContext.Controls.FanMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Section}" Margin="2,10,0,6" Text="{x:Static res:Strings.Wmi2_ChargeLimit}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Choice}" Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Apply}"
                                    CommandParameter="{Binding Controls.ChargeLimitDraft}" Command="{Binding Controls.SetChargeLimitCommand}" />
                            <TextBlock DockPanel.Dock="Right" Width="44" VerticalAlignment="Center" TextAlignment="Right"
                                       Text="{Binding Controls.ChargeLimitDraftLabel}" />
                            <Slider Minimum="{Binding Controls.ChargeLimitMin, Mode=OneTime}" Maximum="{Binding Controls.ChargeLimitMax, Mode=OneTime}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding Controls.ChargeLimitDraft, Mode=TwoWay}"
                                    AutomationProperties.Name="{x:Static res:Strings.Wmi2_ChargeLimit}" />
                        </DockPanel>
                    </StackPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Wmi2_ControlRevert}" Command="{Binding Controls.RevertCommand}"
                                Visibility="{Binding Controls.IsOpen, Converter={StaticResource BoolToVisible}}" />
                        <Button Style="{StaticResource Choice}" Content="{x:Static res:Strings.Wmi2_ControlTurnOff}" Command="{Binding Controls.TurnOffCommand}"
                                Visibility="{Binding Controls.ShowTurnOff, Converter={StaticResource BoolToVisible}}" />
                    </WrapPanel>
                    <Border Style="{StaticResource Band}" Margin="0,8,0,0" Tag="{Binding Controls.ResultKind}"
                            Visibility="{Binding Controls.Result, Converter={StaticResource NotNullToVisible}}">
                        <TextBlock Text="{Binding Controls.Result}" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Controls.RevertLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.ReportOnly_Help}" TextWrapping="Wrap" Margin="0,12,0,12" />
            <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_SendEcData}" Command="{Binding Report.SendEcDataCommand}" />
            <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_Create}" Command="{Binding Report.CreateCommand}" />
            <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_CreateWmi2}" Command="{Binding Report.CreateWithWmi2Command}"
                    Visibility="{Binding Report.HasWmi2, Converter={StaticResource BoolToVisible}}" />
            <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_OpenFolder}" Command="{Binding Report.OpenFolderCommand}"
                    Visibility="{Binding Report.LastReportPath, Converter={StaticResource NotNullToVisible}}" />
            <Button Style="{StaticResource Choice}" Margin="0" Content="{x:Static res:Strings.Report_IssueMenu}" Command="{Binding Report.ReportIssueCommand}" />
            <Border Style="{StaticResource Band}" Margin="0,12,0,0" Tag="{Binding Status.MessageKind}"
                    Visibility="{Binding Status.Message, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap" />
            </Border>
            <Button Style="{StaticResource Choice}" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="100"
                    Content="{x:Static res:Strings.Tray_Exit}" IsCancel="True" />
        </StackPanel>
    </ScrollViewer>
</Window>
