<Window x:Class="MTool.App.Views.ReportOnlyWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MTool.App.Resources"
        Title="{x:Static res:Strings.ReportOnly_Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="16,14,16,16">
        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static res:Strings.ReportOnly_Help}" TextWrapping="Wrap" Margin="0,12,0,12" />
        <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_SendEcData}" Command="{Binding Report.SendEcDataCommand}" />
        <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_Create}" Command="{Binding Report.CreateCommand}" />
        <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_CreateWmi2}" Command="{Binding Report.CreateWithWmi2Command}"
                Visibility="{Binding Report.HasWmi2, Converter={StaticResource BoolToVisible}}" />
        <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Content="{x:Static res:Strings.Report_OpenFolder}" Command="{Binding Report.OpenFolderCommand}"
                Visibility="{Binding Report.LastReportPath, Converter={StaticResource NotNullToVisible}}" />
        <Button Style="{StaticResource Choice}" Margin="0" Content="{x:Static res:Strings.Report_IssueMenu}" Command="{Binding Report.ReportIssueCommand}" />
        <Border Style="{StaticResource Band}" Margin="0,12,0,0" Tag="{Binding Status.MessageKind}"
                Visibility="{Binding Status.Message, Converter={StaticResource NotNullToVisible}}">
            <TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap" />
        </Border>
        <Button Style="{StaticResource Choice}" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="100"
                Content="{x:Static res:Strings.Tray_Exit}" IsCancel="True" />
    </StackPanel>
</Window>
