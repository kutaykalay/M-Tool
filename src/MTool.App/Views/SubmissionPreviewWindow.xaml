<Window x:Class="MTool.App.Views.SubmissionPreviewWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MTool.App.Resources"
        Title="{x:Static res:Strings.Submit_PreviewTitle}" Width="640" Height="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <DockPanel Margin="16,14,16,16">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Submit_PreviewNotice}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,16,0,0" HorizontalAlignment="Right">
            <Button x:Name="SendButton" Style="{StaticResource Choice}" MinWidth="120" Content="{x:Static res:Strings.Submit_Send}" Click="OnSendClick" />
            <Button x:Name="DontSendButton" Style="{StaticResource Choice}" MinWidth="120" Margin="0" Content="{x:Static res:Strings.Submit_DontSend}" IsDefault="True" IsCancel="True" />
        </UniformGrid>
        <TextBox x:Name="PayloadText" AutomationProperties.Name="{x:Static res:Strings.Submit_PreviewTitle}" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" FontSize="12"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}" />
    </DockPanel>
</Window>
