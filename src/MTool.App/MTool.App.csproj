<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MTool.App</RootNamespace>
    <AssemblyName>M-Tool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTool.Core\MTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hardware\Resources\LpcACPIEC.bin" LogicalName="MTool.LpcACPIEC.bin" />
  </ItemGroup>

</Project>
